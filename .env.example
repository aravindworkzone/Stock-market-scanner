NODE_ENV=development
LOG_LEVEL=info
MCP_AUTH_TOKEN=change-me-to-a-random-string-of-at-least-32-chars
PORT=3000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Required (fill in your own values; never commit them)
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PIN=
ANGELONE_TOTP_SECRET=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=

# Optional: directory for the redacted SmartAPI SDK error log (default: ./logs)
# SMARTAPI_LOG_DIR=logs

# Optional: data directory for instruments and the constituent cache (default: ./data)
# DATA_DIR=data

# Optional: refresh the Angel One session this many minutes before its 00:00 IST expiry
# SMARTAPI_SESSION_REFRESH_MARGIN_MINUTES=15

# Optional: per-operation rate limits (official limits are UNKNOWN; defaults are conservative)
# SMARTAPI_RATE_LIMITS={"getCandleData":{"requestsPerSecond":0.5,"burst":1}}
# SMARTAPI_BACKOFF_MAX_RETRIES=3
# SMARTAPI_BACKOFF_INITIAL_MS=2000

# Optional: incremental daily-candle updater
# CANDLE_UPDATE_MARKET_CLOSE_BUFFER_MINUTES=30
# CANDLE_UPDATE_BOOTSTRAP_DAYS=730
# CANDLE_UPDATE_MAX_DAYS_PER_REQUEST=365
# CANDLE_UPDATE_MAX_CONSECUTIVE_RATE_LIMITS=3

# Optional: hours to reuse a fetched NIFTY constituent list
# CONSTITUENT_CACHE_TTL_HOURS=12
